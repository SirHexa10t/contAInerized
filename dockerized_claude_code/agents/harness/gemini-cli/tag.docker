# The harness layer's build-args: the WEEKLY cache-buster, which no other
# layer may reference (test_essential_files) — a week boundary rebuilds the CLI
# and nothing beneath it — and the always-on policies' denies it bakes into
# the CLI's fixed tier (FIXED_POLICY_*; its Dockerfile fails without them).
[build]
arg_forward = ["SOFTWARE_STACK_REFRESH", "FIXED_POLICY_PATH", "FIXED_POLICY_B64", "FIXED_POLICY_COUNT"]
