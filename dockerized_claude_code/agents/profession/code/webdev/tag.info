shortname         = "webdev"
short_description = "headless browser, DNS/TLS lookups"
full_description  = "headless browser automation (playwright + chromium baked in); for web-scraping / browser-testing / dynamic-page extraction. Carries the site toolbox too: dig for DNS records, whois for registration and nameserver facts, openssl for the TLS chain and certificate expiry — the questions a page's own HTML cannot answer. Built on [code]; no display server needed."

[addendum]
title = "Headless browser"
body  = """You're in a headless-browser profession — the `playwright` CLI is available for browser automation. Run `playwright install chromium` (or `firefox` / `webkit`) before first use; subsequent `[code][web]` instances share the same browser cache so the install is idempotent and fast when warm. For Python: `uv pip install playwright` in your project venv.

The site toolbox is installed alongside it, for what a page's own HTML cannot tell you: `dig` for DNS records (what a name resolves to, where a CNAME points, whether a verification TXT is live), `whois` for registration, expiry and delegated nameservers, and `openssl s_client -connect <host>:443` for the certificate chain and its expiry. Reach for these before concluding a site is broken — a failure to load is as often DNS or TLS as it is the page."""
