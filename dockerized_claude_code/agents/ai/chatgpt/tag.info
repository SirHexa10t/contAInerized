shortname         = "ChatGPT"
fullname          = "OpenAI ChatGPT"
short_description = "the mainstream general-purpose assistant; broad knowledge and tool use at every price point"
full_description  = "OpenAI's GPT line (GPT-6 Astra; the GPT-5.6 family Sol, Terra and Luna). The assistant the others are measured against: broad general knowledge, strong tool use and reasoning at every price point, and the largest ecosystem of integrations."
vendor            = "OpenAI"
harness           = "codex-cli"        # its default harness — an agents/harness/ member
key_env           = "OPENAI_API_KEY"        # the vendor's API-key variable: credentials/keys/chatgpt.env defines it — OpenCode, Hermes, OpenClaw read it; Codex CLI takes a key through `codex login --with-api-key` (which writes auth.json) or CODEX_API_KEY for a non-interactive process — its adapter's job, not this file's
default           = false
fg                = "#ffffff"          # the ⟪ChatGPT⟫ tag: white on OpenAI green
bg                = "#10a37f"
