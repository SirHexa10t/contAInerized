# Codex's TIER for every capability standard — the same keys as every
# agents/ai/*/efforts.tiers; agents/ai/capability.standards says what the
# standards are and how a tier is chosen (the cheapest live, rated
# configuration that meets the standard, else the AI's best, flagged). Index
# v4.3 (est. = AA's estimate) and prices in USD per 1M tokens in / out, read
# 2026-09-14 from an AA model page's embedded records; every figure below
# re-read 2026-09-29.
# Prices checked 2026-09-29 against the vendor's own pricing pages, since the
# vendor's list price is what capability.standards makes decisive (AA's is the
# cross-check); every pinned price agrees with AA's.
#
# Codex's scale is model_reasoning_effort low / medium / high / xhigh / max:
# the config reference (read 2026-09-28) documents it as a string the model
# advertises, "such as low, medium, high, xhigh, max, or ultra" — `minimal`
# is gone from it and `max` is in. Not every slug takes `max` (gpt-5.5 tops
# out at xhigh; models.list holds each one's range), and no tier uses it:
# whether Codex accepts it is still a probe (plans/adding_an_ai.md), so
# Astra's `best` stays at xhigh until it is shown (operator, 2026-09-29). The
# harness's own list — learn.chatgpt.com/docs/models, read 2026-09-29 — is
# gpt-6-astra, gpt-6.1-sol, gpt-6-luna and gpt-5.5, and a tier pins only
# those: LAUNCHABLE. gpt-6-sol is live on the API but not on it, so it is no
# tier (operator, 2026-09-29); the 5.6 line "remain[s] available during the
# rollout" and no longer answers any standard. Luna lists no `minimal`, so
# low is its floor.
# Ids verified 2026-09-25 against learn.chatgpt.com/docs/models and
# developers.openai.com's model, pricing and deprecation pages
# (`ai_project-update-models`): every pin is live on the API, none deprecated.
# gpt-6.1-sol verified 2026-09-29 at developers.openai.com (live, 2 / 10, low –
# max, no retirement) and on Codex's model page, which recommends it over
# GPT-6 Sol; AA dates it 2026-09-29, the vendor page gives no date. Rated
# 2026-09-29: gpt-6-luna (0.10 / 0.50, released 2026-09-22) answers cheapest
# through 2025Q4, gpt-6.1-sol 2026Q1 and 2026Q2. Nothing launches Codex yet;
# the Codex adapter (plans/adding_an_ai.md) must re-check its model page
# before it ships. Terra has no GPT-6 successor.
# WHAT A LAUNCH RUNS (2026-09-29): an instance that FOLLOWS its engine runs its
# tier's pair below, model AND effort. One that PINS a model runs that model
# at its highest level unless it pins a level too (agents/ai/<ai>/models.list,
# the tag form's effort row). Every index annotated below is the rated PAIR's,
# so it describes a pinned instance only when it pins that same pair.

[scale]
efforts = ["low", "medium", "high", "xhigh", "max"]

[cheapest]                       # 20.92 · 0.1 / 0.5 — the cheapest model at its lowest effort
model  = "gpt-6-luna"
effort = "low"

[2025Q1]                         # 20.92 · 0.1 / 0.5 — meets 17.71
model  = "gpt-6-luna"
effort = "low"

[2025Q2]                         # 29.46 · 0.1 / 0.5 — low (20.92) misses 21.87 by 0.95
model  = "gpt-6-luna"
effort = "medium"

[2025Q3]                         # 29.46 · 0.1 / 0.5 — meets 24.88
model  = "gpt-6-luna"
effort = "medium"

[2025Q4]                         # 32.15 · 0.1 / 0.5 — meets 30.45
model  = "gpt-6-luna"
effort = "high"

[2026Q1]                         # 42.08 · 2 / 10 — Luna tops out at 37.26 (max); 6.1 Sol at low is the cheapest past 38.98 (Terra at max, 42.08 at 2 / 12, is dearer; GPT-6 Sol at medium, 39.78 at the same price, is not on Codex's list)
model  = "gpt-6.1-sol"
effort = "low"

[2026Q2]                         # 50.24 · 2 / 10 — medium (47.78) misses 49.70; Astra at high (50.92) meets it at five times the price
model  = "gpt-6.1-sol"
effort = "high"

[2026Q3]                         # FALLS SHORT of 57.62: Codex's best, 52.39 (52.67 at `max`, still short)
model  = "gpt-6-astra"
effort = "xhigh"

[best]                           # 52.39 (52.67 at `max`, once Codex is shown to accept it) · 10 / 50
model  = "gpt-6-astra"
effort = "xhigh"

# Also rated: Astra max 52.67 / high 50.92 / medium 49.57 / low 45.78; 6.1 Sol
# max 51.83 / xhigh 51.04 / medium 47.78; GPT-6 Sol (not on Codex's list) max
# 47.53 / xhigh 44.10 / high 42.82 / medium 39.78 / low 33.90 / non-reasoning
# 28.09; 5.6 Sol max 46.97 / xhigh 44.01 / high 42.35 / medium 39.24 / low
# 33.47 / non-reasoning 28.33 est.; Terra max 42.08 / xhigh 37.95 / high 34.24
# / medium 30.09 / low 27.50 / non-reasoning 20.78; GPT-6 Luna max 37.26 /
# xhigh 33.88 / non-reasoning 18.26; 5.6 Luna max 37.32 / xhigh 34.56 / high
# 32.12 / medium 25.04 / low 21.01 / non-reasoning 15.53; GPT-5.5 xhigh 38.36 /
# high 36.98 / medium 33.80 / low 30.71 est. (leaves ChatGPT and Codex
# 2026-10-14, stays on the API; OpenAI points to GPT-6 Sol).
# gpt-5.3-codex-spark is not rated.
